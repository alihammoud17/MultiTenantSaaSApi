# Build output from the build role (published API, EF migrations bundle, BillingService dist).
build/
# Generated by scripts/inventory.sh and scripts/test-host.sh.
inventories/*/hosts.yml
# Secrets. Copy vault.example.yml and encrypt it with ansible-vault; never commit it.
inventories/*/group_vars/all/vault.yml
.vault-pass
# Throwaway SSH key for the local systemd test host.
tests/systemd-host/id_ed25519*
