# {{ ansible_managed }}
# Keys mirror deploy/env-examples/billing.env.example.
NODE_ENV=production
PORT={{ app_billing_port }}
SERVICE_NAME=billing
BILLING_PROVIDER={{ billing_provider }}

WEBHOOK_SIGNING_SECRET={{ vault_webhook_signing_secret }}

DOTNET_CALLBACK_BASE_URL=http://127.0.0.1:{{ app_api_port }}
INTERNAL_BILLING_SHARED_SECRET={{ vault_billing_shared_secret }}

STRIPE_API_KEY={{ vault_stripe_api_key }}
STRIPE_API_BASE_URL={{ billing_stripe_api_base_url }}

WORKFLOW_STATE_PATH=/var/lib/{{ billing_state_directory }}/billing-workflow-state.json
WORKFLOW_MAX_ATTEMPTS={{ billing_workflow_max_attempts }}
WORKFLOW_INITIAL_BACKOFF_MS={{ billing_workflow_initial_backoff_ms }}
WORKFLOW_MAX_BACKOFF_MS={{ billing_workflow_max_backoff_ms }}
WORKFLOW_POLL_INTERVAL_MS={{ billing_workflow_poll_interval_ms }}
RECONCILIATION_INTERVAL_MS={{ billing_reconciliation_interval_ms }}
