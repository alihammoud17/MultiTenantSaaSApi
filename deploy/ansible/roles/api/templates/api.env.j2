# {{ ansible_managed }}
# Keys mirror deploy/env-examples/api.env.example.
ASPNETCORE_ENVIRONMENT={{ app_environment }}
ASPNETCORE_URLS=http://127.0.0.1:{{ app_api_port }}
DOTNET_CLI_TELEMETRY_OPTOUT=1

ConnectionStrings__DefaultConnection={{ api_connection_string }}
Redis__ConnectionString=127.0.0.1:{{ app_redis_port }},password={{ vault_redis_password }}

Jwt__Secret={{ vault_jwt_secret }}
Jwt__Issuer={{ api_jwt_issuer }}
Jwt__Audience={{ api_jwt_audience }}
Jwt__ExpirationMinutes={{ api_jwt_expiration_minutes }}

BillingIntegration__SharedSecret={{ vault_billing_shared_secret }}
BillingIntegration__AllowedClockSkewMinutes={{ api_clock_skew_minutes }}

TenantOperations__SharedSecret={{ vault_tenant_operations_shared_secret }}
TenantOperations__AllowedClockSkewMinutes={{ api_clock_skew_minutes }}

TenantResolution__BaseDomain={{ app_tenant_base_domain }}

# Empty allows no cross-origin browser calls outside Development.
Cors__AllowedOrigins={{ api_cors_allowed_origins | join(',') }}

# NGINX proxies from 127.0.0.1, which ASP.NET Core trusts by default, so no
# ForwardedHeaders__KnownNetworks entry is needed on this single host.

SERVICE_NAME=api
{% for key, value in api_extra_environment.items() %}
{{ key }}={{ value }}
{% endfor %}
